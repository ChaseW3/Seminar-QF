    "# Plot volatility evolution around COVID to show the lag effect\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.dates as mdates\n",
    "\n",
    "fig, axes = plt.subplots(3, 1, figsize=(14, 12))\n",
    "\n",
    "# Calculate daily statistics for asset volatility\n",
    "merton_df_copy = merton_df.copy()\n",
    "merton_df_copy['date'] = pd.to_datetime(merton_df_copy['date'])\n",
    "\n",
    "# Focus on 2019-2024\n",
    "plot_data = merton_df_copy[(merton_df_copy['date'] >= '2019-01-01') & \n",
    "                            (merton_df_copy['date'] <= '2024-12-31')]\n",
    "\n",
    "# Group by date and calculate statistics\n",
    "daily_vol = plot_data.groupby('date')['asset_volatility'].agg([\n",
    "    ('mean', 'mean'),\n",
    "    ('median', 'median'),\n",
    "    ('q75', lambda x: np.percentile(x.dropna(), 75)),\n",
    "    ('q90', lambda x: np.percentile(x.dropna(), 90)),\n",
    "]).reset_index()\n",
    "\n",
    "# Plot 1: Asset Volatility over time\n",
    "axes[0].plot(daily_vol['date'], daily_vol['mean']*100, label='Mean', linewidth=2, color='red', alpha=0.7)\n",
    "axes[0].plot(daily_vol['date'], daily_vol['median']*100, label='Median', linewidth=2, color='blue')\n",
    "axes[0].fill_between(daily_vol['date'], daily_vol['median']*100, daily_vol['q90']*100, \n",
    "                      alpha=0.2, label='Median to 90th %ile')\n",
    "axes[0].axvline(pd.Timestamp('2020-03-01'), color='red', linestyle='--', alpha=0.7, linewidth=2, label='COVID Start')\n",
    "axes[0].axvline(pd.Timestamp('2023-03-10'), color='orange', linestyle='--', alpha=0.7, linewidth=2, label='SVB Collapse')\n",
    "axes[0].set_title('Asset Volatility Over Time (Input to GARCH Model)', fontsize=14, fontweight='bold')\n",
    "axes[0].set_ylabel('Volatility (%)', fontsize=12)\n",
    "axes[0].legend(fontsize=10)\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 2: GARCH CDS Spreads (5Y) over time\n",
    "garch_daily = df_garch.groupby('date')['spread_5y_bps'].agg([\n",
    "    ('mean', 'mean'),\n",
    "    ('median', 'median'),\n",
    "    ('q75', lambda x: np.percentile(x.dropna(), 75) if len(x.dropna()) > 0 else np.nan),\n",
    "]).reset_index()\n",
    "garch_daily['date'] = pd.to_datetime(garch_daily['date'])\n",
