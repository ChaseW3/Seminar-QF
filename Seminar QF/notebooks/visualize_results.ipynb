    "             label=f'Regression (slope={z[0]:.2f})')\n",
    "    \n",
    "    ax2.set_xlabel('Market Median CDS Spread (bps)', fontsize=12)\n",
    "    ax2.set_ylabel(f'{model_name} Median Spread (bps)', fontsize=12)\n",
    "    ax2.set_title('Median Spreads: Scatter Plot', fontsize=13, fontweight='bold')\n",
