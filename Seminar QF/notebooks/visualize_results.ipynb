    "def plot_all_models_probability_of_default(maturity=5, gvkey=None, models=None):\n",
    "    \"\"\"\n",
    "    Compare probability of default (PD) across all models over time.\n",
    "    Can show either a single company or median across all firms.\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    maturity : int\n",
    "        Maturity in years (1, 3, or 5)\n",
    "    gvkey : int, optional\n",
    "        Specific firm to plot. If None, shows median across all firms\n",
    "    models : list, optional\n",
    "        List of models to compare. If None, uses all available models\n",
    "    \"\"\"\n",
    "    if models is None:\n",
    "        models = ['Merton', 'GARCH', 'Regime Switching', 'MS-GARCH']\n",
    "    \n",
    "    # Model colors\n",
    "    model_colors = {\n",
    "        'Merton': '#ff7f0e',           # Orange\n",
    "        'GARCH': '#1f77b4',            # Blue\n",
    "        'Regime Switching': '#2ca02c', # Green\n",
    "        'MS-GARCH': '#d62728',         # Red\n",
    "    }\n",
    "    \n",
    "    # PD column mapping\n",
    "    pd_col_mapping = {\n",
    "        'GARCH': f'mc_garch_pd_{maturity}y',\n",
    "        'Regime Switching': f'rs_pd_{maturity}y',\n",
    "        'MS-GARCH': f'mc_ms_garch_pd_{maturity}y',\n",
    "        'Merton': f'merton_mc_pd_{maturity}y'\n",
    "    }\n",
    "    \n",
    "    fig, ax = plt.subplots(figsize=(14, 8))\n",
    "    \n",
    "    # Get company name if gvkey provided\n",
    "    if gvkey is not None:\n",
    "        company_name = merton_df[merton_df['gvkey'] == gvkey]['company'].iloc[0] if len(merton_df[merton_df['gvkey'] == gvkey]) > 0 else f\"Firm {gvkey}\"\n",
    "        title = f'Probability of Default Comparison: {company_name} ({maturity}-Year Maturity)'\n",
    "    else:\n",
    "        title = f'Median Probability of Default Comparison ({maturity}-Year Maturity)'\n",
    "    \n",
    "    stats_data = []\n",
    "    \n",
    "    for model_name in models:\n",
    "        if model_name not in plotter.data:\n",
    "            print(f\"Warning: Model '{model_name}' not loaded. Skipping.\")\n",
    "            continue\n",
    "        \n",
    "        model_df = plotter.data[model_name].copy()\n",
    "        model_df['date'] = pd.to_datetime(model_df['date'])\n",
    "        \n",
    "        pd_col = pd_col_mapping.get(model_name)\n",
    "        if pd_col not in model_df.columns:\n",
    "            print(f\"Warning: PD column '{pd_col}' not found in {model_name} data. Skipping.\")\n",
    "            continue\n",
    "        \n",
    "        # Convert to percentage\n",
    "        model_df['pd_pct'] = model_df[pd_col] * 100\n",
    "        \n",
    "        if gvkey is not None:\n",
    "            # Plot specific company\n",
    "            company_data = model_df[model_df['gvkey'] == gvkey].copy()\n",
    "            if company_data.empty:\n",
    "                print(f\"Warning: No data found for firm {gvkey} in {model_name}. Skipping.\")\n",
    "                continue\n",
    "            \n",
    "            company_data = company_data.sort_values('date')\n",
    "            ax.plot(company_data['date'], company_data['pd_pct'], \n",
    "                    linewidth=2, label=model_name, \n",
    "                    color=model_colors.get(model_name, None), alpha=0.8)\n",
    "            \n",
    "            # Collect statistics\n",
    "            stats_data.append({\n",
    "                'Model': model_name,\n",
    "                'Mean (%)': company_data['pd_pct'].mean(),\n",
    "                'Std (%)': company_data['pd_pct'].std(),\n",
    "                'Min (%)': company_data['pd_pct'].min(),\n",
    "                'Max (%)': company_data['pd_pct'].max()\n",
    "            })\n",
    "        else:\n",
    "            # Plot median across all firms\n",
    "            median_pd = model_df.groupby('date')['pd_pct'].median().reset_index()\n",
    "            median_pd = median_pd.sort_values('date')\n",
    "            \n",
    "            ax.plot(median_pd['date'], median_pd['pd_pct'], \n",
    "                    linewidth=2, label=model_name, \n",
    "                    color=model_colors.get(model_name, None), alpha=0.8)\n",
    "            \n",
    "            # Collect statistics\n",
    "            stats_data.append({\n",
    "                'Model': model_name,\n",
    "                'Mean (%)': median_pd['pd_pct'].mean(),\n",
    "                'Std (%)': median_pd['pd_pct'].std(),\n",
    "                'Min (%)': median_pd['pd_pct'].min(),\n",
    "                'Max (%)': median_pd['pd_pct'].max()\n",
    "            })\n",
    "    \n",
    "    ax.set_title(title, fontsize=14, fontweight='bold')\n",
    "    ax.set_xlabel('Date', fontsize=12)\n",
    "    ax.set_ylabel('Probability of Default (%)', fontsize=12)\n",
    "    ax.legend(loc='best', fontsize=11)\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # Print statistics table\n",
    "    if stats_data:\n",
    "        stats_df = pd.DataFrame(stats_data)\n",
    "        print(f\"\\nProbability of Default Statistics ({maturity}Y):\")\n",
    "        print(stats_df.to_string(index=False, float_format=lambda x: f'{x:.4f}'))\n",
    "\n",
    "print(\"✓ Function 'plot_all_models_probability_of_default' defined\")"
   ]
