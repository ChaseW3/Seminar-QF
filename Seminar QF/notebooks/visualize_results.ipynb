    "def plot_distribution_statistics(model_name, maturity=5):\n",
    "    \"\"\"\n",
    "    Plot mean, median, 25th percentile, and 75th percentile over time for a specific maturity.\n",
    "    This visualizes the distribution and skewness of CDS spreads.\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    model_name : str\n",
    "        The model to plot ('GARCH', 'Regime Switching', 'MS-GARCH', 'Merton')\n",
    "    maturity : int\n",
    "        Maturity in years (1, 3, or 5)\n",
    "    \"\"\"\n",
    "    if model_name not in plotter.data:\n",
    "        print(f\"Error: Model '{model_name}' not loaded.\")\n",
    "        return\n",
    "    \n",
    "    df = plotter.data[model_name].copy()\n",
    "    df['date'] = pd.to_datetime(df['date'])\n",
    "    col_name = f'spread_{maturity}y_bps'\n",
    "    \n",
    "    if col_name not in df.columns:\n",
    "        print(f\"Error: {col_name} not found in data\")\n",
    "        return\n",
    "    \n",
    "    # Calculate daily statistics\n",
    "    daily_stats = df.groupby('date')[col_name].agg([\n",
    "        ('mean', 'mean'),\n",
    "        ('median', 'median'),\n",
    "        ('q25', lambda x: x.quantile(0.25)),\n",
    "        ('q75', lambda x: x.quantile(0.75))\n",
    "    ]).reset_index()\n",
    "    \n",
    "    # Create figure\n",
    "    fig, ax = plt.subplots(figsize=(14, 8))\n",
    "    \n",
    "    # Plot mean (thicker line, most important)\n",
    "    ax.plot(daily_stats['date'], daily_stats['mean'], \n",
    "            linewidth=2.5, label='Mean', color='#d62728', alpha=0.9)\n",
    "    \n",
    "    # Plot median\n",
    "    ax.plot(daily_stats['date'], daily_stats['median'], \n",
    "            linewidth=2, label='Median (50th percentile)', color='#1f77b4', alpha=0.8)\n",
    "    \n",
    "    # Plot 25th and 75th percentiles\n",
    "    ax.plot(daily_stats['date'], daily_stats['q75'], \n",
    "            linewidth=1.5, label='75th percentile', color='#2ca02c', alpha=0.7, linestyle='--')\n",
    "    ax.plot(daily_stats['date'], daily_stats['q25'], \n",
    "            linewidth=1.5, label='25th percentile', color='#ff7f0e', alpha=0.7, linestyle='--')\n",
    "    \n",
    "    # Fill area between 25th and 75th percentiles\n",
    "    ax.fill_between(daily_stats['date'], daily_stats['q25'], daily_stats['q75'], \n",
    "                     alpha=0.15, color='gray', label='Interquartile range (25th-75th)')\n",
    "    \n",
    "    # Add vertical line for COVID start\n",
    "    ax.axvline(pd.Timestamp('2020-03-01'), color='red', linestyle=':', \n",
    "               alpha=0.5, linewidth=2, label='COVID-19 Start')\n",
    "    \n",
    "    # Labels and formatting\n",
    "    ax.set_title(f'{model_name} CDS Spread Distribution Over Time ({maturity}-Year Maturity)\\n' +\n",
    "                 'Mean, Median, and Quartiles',\n",
    "                 fontsize=14, fontweight='bold')\n",
    "    ax.set_xlabel('Date', fontsize=12)\n",
    "    ax.set_ylabel('CDS Spread (basis points)', fontsize=12)\n",
    "    ax.legend(loc='best', fontsize=10, framealpha=0.9)\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # Print summary statistics for key periods\n",
    "    print(f\"\\n{'='*90}\")\n",
    "    print(f\"SUMMARY STATISTICS: {model_name} - {maturity}Y Maturity\")\n",
    "    print(f\"{'='*90}\")\n",
    "    \n",
    "    periods = [\n",
    "        ('2020-03-01', '2020-05-31', 'COVID Peak (Mar-May 2020)'),\n",
    "        ('2023-01-01', '2023-03-31', 'Banking Crisis (Jan-Mar 2023)'),\n",
    "        ('2024-01-01', '2024-12-31', 'Recent Period (2024)'),\n",
    "    ]\n",
    "    \n",
    "    print(f\"\\n{'Period':<30} {'Mean':<10} {'Median':<10} {'25th %':<10} {'75th %':<10} {'Spread':<10}\")\n",
    "    print(f\"{'':<30} {'(bps)':<10} {'(bps)':<10} {'(bps)':<10} {'(bps)':<10} {'Q75-Q25':<10}\")\n",
    "    print(\"-\"*90)\n",
    "    \n",
    "    for start, end, label in periods:\n",
    "        period_data = daily_stats[(daily_stats['date'] >= start) & (daily_stats['date'] <= end)]\n",
    "        if not period_data.empty:\n",
    "            mean_avg = period_data['mean'].mean()\n",
    "            median_avg = period_data['median'].mean()\n",
    "            q25_avg = period_data['q25'].mean()\n",
    "            q75_avg = period_data['q75'].mean()\n",
    "            spread = q75_avg - q25_avg\n",
    "            \n",
    "            print(f\"{label:<30} {mean_avg:>9.2f}  {median_avg:>9.2f}  {q25_avg:>9.2f}  {q75_avg:>9.2f}  {spread:>9.2f}\")\n",
    "    \n",
    "    print(f\"\\n💡 Key Insight:\")\n",
    "    print(f\"   When MEAN >> MEDIAN, the distribution is highly skewed (few firms with very high spreads)\")\n",
    "    print(f\"   When MEAN ≈ MEDIAN, the distribution is more symmetric\")\n",
    "    print(f\"   The interquartile range (Q75-Q25) shows the spread of the middle 50% of firms\")\n",
    "\n",
    "print(\"✓ Function 'plot_distribution_statistics' defined\")"
   ]
  },
