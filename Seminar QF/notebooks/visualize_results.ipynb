    "# Check how many firms are in the dataset over time and their spread distribution\n",
    "def analyze_firm_count_over_time(model_name='GARCH', maturity=5):\n",
    "    \"\"\"\n",
    "    Track the number of firms and spread distribution over time\n",
    "    \"\"\"\n",
    "    df = plotter.data[model_name].copy()\n",
    "    df['date'] = pd.to_datetime(df['date'])\n",
    "    col_name = f'spread_{maturity}y_bps'\n",
    "    \n",
    "    # Group by date and get statistics\n",
    "    daily_stats = df.groupby('date').agg({\n",
    "        'gvkey': 'nunique',\n",
    "        col_name: ['count', 'mean', 'median', 'std', \n",
    "                   lambda x: (x > 0).sum(),  # non-zero count\n",
    "                   lambda x: (x > 10).sum(),  # high spread count\n",
    "                   lambda x: x.quantile(0.25),\n",
    "                   lambda x: x.quantile(0.75)]\n",
    "    }).reset_index()\n",
    "    \n",
    "    daily_stats.columns = ['date', 'unique_firms', 'total_obs', 'mean', 'median', 'std', \n",
    "                           'non_zero', 'above_10bps', 'q25', 'q75']\n",
    "    \n",
    "    # Focus on key periods\n",
    "    print(\"=\"*100)\n",
    "    print(f\"FIRM COUNT AND SPREAD DISTRIBUTION OVER TIME - {model_name}\")\n",
    "    print(\"=\"*100)\n",
    "    \n",
    "    periods = [\n",
    "        ('2020-01-01', '2020-01-31', 'Early 2020 (Pre-COVID)'),\n",
    "        ('2020-03-01', '2020-03-31', 'March 2020 (COVID Start)'),\n",
    "        ('2020-06-01', '2020-06-30', 'June 2020 (Mid-COVID)'),\n",
    "        ('2022-01-01', '2022-01-31', 'Early 2022'),\n",
    "        ('2023-01-01', '2023-01-31', 'Early 2023'),\n",
    "        ('2024-01-01', '2024-01-31', 'Early 2024'),\n",
    "    ]\n",
    "    \n",
    "    for start, end, label in periods:\n",
    "        period_data = daily_stats[(daily_stats['date'] >= start) & (daily_stats['date'] <= end)]\n",
    "        if not period_data.empty:\n",
    "            print(f\"\\n{label}\")\n",
    "            print(f\"  Avg # of firms: {period_data['unique_firms'].mean():.1f}\")\n",
    "            print(f\"  Avg median spread: {period_data['median'].mean():.2f} bps\")\n",
    "            print(f\"  Avg mean spread: {period_data['mean'].mean():.2f} bps\")\n",
    "            print(f\"  Avg firms with spread > 10 bps: {period_data['above_10bps'].mean():.1f}\")\n",
    "            print(f\"  Avg 25th percentile: {period_data['q25'].mean():.2f} bps\")\n",
    "            print(f\"  Avg 75th percentile: {period_data['q75'].mean():.2f} bps\")\n",
    "    \n",
    "    # Plot over time\n",
    "    import matplotlib.pyplot as plt\n",
    "    fig, axes = plt.subplots(3, 1, figsize=(14, 12))\n",
    "    \n",
    "    # Plot 1: Number of firms\n",
    "    axes[0].plot(daily_stats['date'], daily_stats['unique_firms'], linewidth=1.5, color='blue')\n",
    "    axes[0].set_title(f'{model_name}: Number of Firms in Dataset Over Time', fontsize=14, fontweight='bold')\n",
    "    axes[0].set_ylabel('Number of Firms', fontsize=12)\n",
    "    axes[0].grid(True, alpha=0.3)\n",
    "    axes[0].axvline(pd.Timestamp('2020-03-01'), color='red', linestyle='--', alpha=0.5, label='COVID Start')\n",
    "    axes[0].legend()\n",
    "    \n",
    "    # Plot 2: Mean vs Median spreads\n",
    "    axes[1].plot(daily_stats['date'], daily_stats['mean'], linewidth=1.5, label='Mean', color='orange', alpha=0.8)\n",
