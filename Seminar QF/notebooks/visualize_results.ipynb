    "# Identify firms that enter and leave the dataset\n",
    "def identify_entering_leaving_firms(model_name='GARCH', maturity=5):\n",
    "    \"\"\"\n",
    "    Identify which firms enter and leave the dataset over time\n",
    "    \"\"\"\n",
    "    df = plotter.data[model_name].copy()\n",
    "    df['date'] = pd.to_datetime(df['date'])\n",
    "    \n",
    "    # Get all unique dates sorted\n",
    "    all_dates = sorted(df['date'].unique())\n",
    "    \n",
    "    # Track firms present at each date\n",
    "    firms_by_date = {}\n",
    "    for date in all_dates:\n",
    "        firms = set(df[df['date'] == date]['gvkey'].unique())\n",
    "        firms_by_date[date] = firms\n",
    "    \n",
    "    # Identify entering and leaving firms\n",
    "    entering_firms = {}\n",
    "    leaving_firms = {}\n",
    "    \n",
    "    for i in range(1, len(all_dates)):\n",
    "        prev_date = all_dates[i-1]\n",
    "        curr_date = all_dates[i]\n",
    "        \n",
    "        prev_firms = firms_by_date[prev_date]\n",
    "        curr_firms = firms_by_date[curr_date]\n",
    "        \n",
    "        # Firms that entered (in current but not in previous)\n",
    "        entered = curr_firms - prev_firms\n",
    "        if entered:\n",
    "            entering_firms[curr_date] = entered\n",
    "        \n",
    "        # Firms that left (in previous but not in current)\n",
    "        left = prev_firms - curr_firms\n",
    "        if left:\n",
    "            leaving_firms[prev_date] = left\n",
    "    \n",
    "    # Print summary\n",
    "    print(\"=\"*100)\n",
    "    print(f\"FIRMS ENTERING AND LEAVING THE DATASET - {model_name}\")\n",
    "    print(\"=\"*100)\n",
    "    \n",
    "    print(f\"\\nTotal unique firms in dataset: {len(df['gvkey'].unique())}\")\n",
    "    print(f\"Date range: {all_dates[0].strftime('%Y-%m-%d')} to {all_dates[-1].strftime('%Y-%m-%d')}\")\n",
    "    \n",
    "    # Load company name mapping from the CDS clean file\n",
    "    gvkey_to_company = {}\n",
    "    try:\n",
    "        cds_clean_file = config.DATA_DIR / 'cds_filters' / 'cds_clean_for_comparison.csv'\n",
    "        if cds_clean_file.exists():\n",
    "            cds_df = pd.read_csv(cds_clean_file)\n",
    "            # Create mapping from gvkey to company name (mapped_company is the standardized name)\n",
    "            gvkey_to_company = cds_df[['gvkey', 'mapped_company']].drop_duplicates().dropna()\n",
    "            gvkey_to_company = gvkey_to_company.set_index('gvkey')['mapped_company'].to_dict()\n",
    "            print(f\"✓ Loaded company names for {len(gvkey_to_company)} firms\")\n",
    "        else:\n",
    "            print(f\"⚠️ Company name file not found at {cds_clean_file}\")\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ Could not load company names: {e}\")\n",
    "    \n",
    "    # Load leverage data from merged Merton file\n",
    "    gvkey_to_leverage_group = {}\n",
    "    try:\n",
    "        merton_file = config.OUTPUT_DIR / 'merged_data_with_merton.csv'\n",
    "        if merton_file.exists():\n",
    "            merton_df = pd.read_csv(merton_file)\n",
    "            # Calculate leverage ratio for each firm-date: Debt / Assets\n",
    "            merton_df['leverage_ratio'] = merton_df['liabilities_total'] / merton_df['asset_value']\n",
    "            # Get median leverage per firm\n",
    "            firm_leverage = merton_df.groupby('gvkey')['leverage_ratio'].median()\n",
    "            \n",
    "            # Define leverage groups based on quantiles\n",
    "            q33 = firm_leverage.quantile(0.33)\n",
    "            q67 = firm_leverage.quantile(0.67)\n",
    "            \n",
    "            def get_leverage_group(lev):\n",
    "                if pd.isna(lev):\n",
    "                    return 'Unknown'\n",
    "                elif lev < q33:\n",
    "                    return 'Low Leverage'\n",
    "                elif lev < q67:\n",
    "                    return 'Medium Leverage'\n",
    "                else:\n",
    "                    return 'High Leverage'\n",
    "            \n",
    "            gvkey_to_leverage_group = {gvkey: get_leverage_group(lev) for gvkey, lev in firm_leverage.items()}\n",
    "            print(f\"✓ Loaded leverage data for {len(gvkey_to_leverage_group)} firms\")\n",
    "            print(f\"  Leverage thresholds: Low < {q33:.2f}, Medium < {q67:.2f}, High >= {q67:.2f}\")\n",
    "        else:\n",
    "            print(f\"⚠️ Merton file not found at {merton_file}\")\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ Could not load leverage data: {e}\")\n",
    "    \n",
    "    # Show firms entering\n",
    "    if entering_firms:\n",
    "        print(\"\\n\" + \"=\"*100)\n",
    "        print(\"FIRMS ENTERING THE DATASET\")\n",
    "        print(\"=\"*100)\n",
    "        \n",
    "        # Sort by date and show key periods\n",
    "        for date in sorted(entering_firms.keys()):\n",
    "            firms = entering_firms[date]\n",
    "            print(f\"\\n📅 {date.strftime('%Y-%m-%d')} - {len(firms)} firm(s) entered:\")\n",
    "            for gvkey in sorted(firms):\n",
    "                gvkey_int = int(gvkey) if isinstance(gvkey, float) else gvkey\n",
    "                company_name = gvkey_to_company.get(gvkey_int, 'Unknown Company')\n",
    "                leverage_group = gvkey_to_leverage_group.get(gvkey_int, 'Unknown')\n",
    "                print(f\"   • {company_name} (gvkey: {gvkey}) - {leverage_group}\")\n",
    "    \n",
    "    # Show firms leaving\n",
    "    if leaving_firms:\n",
    "        print(\"\\n\" + \"=\"*100)\n",
    "        print(\"FIRMS LEAVING THE DATASET\")\n",
    "        print(\"=\"*100)\n",
    "        \n",
    "        # Sort by date and show key periods\n",
    "        for date in sorted(leaving_firms.keys()):\n",
    "            firms = leaving_firms[date]\n",
    "            print(f\"\\n📅 After {date.strftime('%Y-%m-%d')} - {len(firms)} firm(s) left:\")\n",
    "            for gvkey in sorted(firms):\n",
    "                gvkey_int = int(gvkey) if isinstance(gvkey, float) else gvkey\n",
    "                company_name = gvkey_to_company.get(gvkey_int, 'Unknown Company')\n",
    "                leverage_group = gvkey_to_leverage_group.get(gvkey_int, 'Unknown')\n",
    "                print(f\"   • {company_name} (gvkey: {gvkey}) - {leverage_group}\")\n",
    "    \n",
    "    # Summary statistics\n",
    "    print(\"\\n\" + \"=\"*100)\n",
    "    print(\"SUMMARY\")\n",
    "    print(\"=\"*100)\n",
    "    print(f\"Total number of entry events: {sum(len(firms) for firms in entering_firms.values())}\")\n",
    "    print(f\"Total number of exit events: {sum(len(firms) for firms in leaving_firms.values())}\")\n",
    "    \n",
    "    # Find firms present at start vs end\n",
    "    first_firms = firms_by_date[all_dates[0]]\n",
    "    last_firms = firms_by_date[all_dates[-1]]\n",
    "    \n",
    "    always_present = first_firms & last_firms\n",
    "    print(f\"\\nFirms present at both start and end: {len(always_present)}\")\n",
    "    print(f\"Firms only at start: {len(first_firms - last_firms)}\")\n",
    "    print(f\"Firms only at end: {len(last_firms - first_firms)}\")\n",
    "    \n",
    "    return entering_firms, leaving_firms, firms_by_date\n",
    "\n",
    "# Run the analysis\n",
    "entering, leaving, firms_by_date = identify_entering_leaving_firms('GARCH', maturity=5)"
   ]
