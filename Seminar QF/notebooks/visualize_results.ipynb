   ],
   "source": [
    "def plot_model_probability_of_default(model_name, maturity=5, gvkey=None, show_median=True):\n",
    "    \"\"\"\n",
    "    Plot probability of default (PD) for a specific model over time.\n",
    "    Can show either a single company or median across all firms.\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    model_name : str\n",
    "        The model to plot ('GARCH', 'Regime Switching', 'MS-GARCH', 'Merton')\n",
    "    maturity : int\n",
    "        Maturity in years (1, 3, or 5)\n",
    "    gvkey : int, optional\n",
    "        Specific firm to plot. If None, shows median across all firms\n",
    "    show_median : bool\n",
    "        If True and gvkey is None, shows median. If False, shows individual firms (can be messy)\n",
    "    \"\"\"\n",
    "    if model_name not in plotter.data:\n",
    "        print(f\"Error: Model '{model_name}' not loaded.\")\n",
    "        return\n",
    "    \n",
    "    model_df = plotter.data[model_name].copy()\n",
    "    model_df['date'] = pd.to_datetime(model_df['date'])\n",
    "    \n",
    "    # Determine PD column name based on model\n",
    "    pd_col_mapping = {\n",
    "        'GARCH': f'mc_garch_pd_{maturity}y',\n",
    "        'Regime Switching': f'rs_pd_{maturity}y',\n",
    "        'MS-GARCH': f'mc_ms_garch_pd_{maturity}y',\n",
    "        'Merton': f'merton_mc_pd_{maturity}y'\n",
    "    }\n",
    "    \n",
    "    pd_col = pd_col_mapping.get(model_name)\n",
    "    if pd_col not in model_df.columns:\n",
    "        print(f\"Error: PD column '{pd_col}' not found in {model_name} data\")\n",
    "        print(f\"Available columns: {[c for c in model_df.columns if 'pd' in c.lower()]}\")\n",
    "        return\n",
    "    \n",
    "    # Convert to percentage\n",
    "    model_df['pd_pct'] = model_df[pd_col] * 100\n",
    "    \n",
    "    fig, ax = plt.subplots(figsize=(14, 7))\n",
    "    \n",
    "    if gvkey is not None:\n",
    "        # Plot specific company\n",
    "        company_data = model_df[model_df['gvkey'] == gvkey].copy()\n",
    "        if company_data.empty:\n",
    "            print(f\"No data found for firm {gvkey}\")\n",
    "            return\n",
    "        \n",
    "        company_name = merton_df[merton_df['gvkey'] == gvkey]['company'].iloc[0] if len(merton_df[merton_df['gvkey'] == gvkey]) > 0 else f\"Firm {gvkey}\"\n",
    "        company_data = company_data.sort_values('date')\n",
    "        \n",
    "        ax.plot(company_data['date'], company_data['pd_pct'], \n",
    "                linewidth=2, label=company_name, color='#d62728', alpha=0.8)\n",
    "        \n",
    "        title = f'{model_name} Probability of Default: {company_name} ({maturity}-Year Maturity)'\n",
    "        \n",
    "        # Print statistics\n",
    "        print(f\"\\nPD Statistics for {company_name} ({maturity}Y):\")\n",
    "        print(f\"  Mean PD: {company_data['pd_pct'].mean():.4f}%\")\n",
    "        print(f\"  Std PD:  {company_data['pd_pct'].std():.4f}%\")\n",
    "        print(f\"  Min PD:  {company_data['pd_pct'].min():.4f}%\")\n",
    "        print(f\"  Max PD:  {company_data['pd_pct'].max():.4f}%\")\n",
    "        \n",
    "    else:\n",
    "        if show_median:\n",
    "            # Plot median across all firms\n",
    "            median_pd = model_df.groupby('date')['pd_pct'].median().reset_index()\n",
    "            median_pd = median_pd.sort_values('date')\n",
    "            \n",
    "            ax.plot(median_pd['date'], median_pd['pd_pct'], \n",
    "                    linewidth=2.5, label='Median across all firms', color='#d62728', alpha=0.8)\n",
    "            \n",
    "            title = f'{model_name} Median Probability of Default ({maturity}-Year Maturity)'\n",
    "            \n",
    "            # Print statistics\n",
    "            print(f\"\\nMedian PD Statistics ({maturity}Y):\")\n",
    "            print(f\"  Mean of Medians: {median_pd['pd_pct'].mean():.4f}%\")\n",
    "            print(f\"  Std of Medians:  {median_pd['pd_pct'].std():.4f}%\")\n",
    "            print(f\"  Min Median:      {median_pd['pd_pct'].min():.4f}%\")\n",
    "            print(f\"  Max Median:      {median_pd['pd_pct'].max():.4f}%\")\n",
    "        else:\n",
    "            # Plot all firms (can be messy)\n",
    "            for gv in model_df['gvkey'].unique():\n",
    "                firm_data = model_df[model_df['gvkey'] == gv].sort_values('date')\n",
    "                ax.plot(firm_data['date'], firm_data['pd_pct'], \n",
    "                        linewidth=0.5, alpha=0.3)\n",
