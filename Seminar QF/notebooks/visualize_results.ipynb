    "# DEEP DIVE: Investigate why 2020 looks lower than 2023\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def investigate_time_period_issue(model_name='GARCH', maturity=5):\n",
    "    \"\"\"\n",
    "    Compare firm composition and data quality between 2020 and 2023\n",
    "    \"\"\"\n",
    "    if model_name not in plotter.data:\n",
    "        print(f\"Error: {model_name} not loaded\")\n",
    "        return\n",
    "    \n",
    "    df = plotter.data[model_name].copy()\n",
    "    df['date'] = pd.to_datetime(df['date'])\n",
    "    col_name = f'spread_{maturity}y_bps'\n",
    "    \n",
    "    # Define periods\n",
    "    crisis_2020 = df[(df['date'] >= '2020-03-01') & (df['date'] <= '2020-05-31')]\n",
    "    period_2023 = df[(df['date'] >= '2023-01-01') & (df['date'] <= '2023-03-31')]\n",
    "    \n",
    "    print(\"=\"*100)\n",
    "    print(f\"INVESTIGATION: {model_name} Model - {maturity}Y Maturity\")\n",
    "    print(\"=\"*100)\n",
    "    \n",
    "    # 1. Check firm composition\n",
    "    print(\"\\n1️⃣  FIRM COMPOSITION\")\n",
    "    print(\"-\"*100)\n",
    "    \n",
    "    firms_2020 = set(crisis_2020['gvkey'].unique())\n",
    "    firms_2023 = set(period_2023['gvkey'].unique())\n",
    "    \n",
    "    print(f\"Firms in 2020 (Mar-May): {len(firms_2020)}\")\n",
    "    print(f\"Firms in 2023 (Jan-Mar): {len(firms_2023)}\")\n",
    "    print(f\"Firms in both periods: {len(firms_2020 & firms_2023)}\")\n",
    "    print(f\"Firms only in 2020: {len(firms_2020 - firms_2023)}\")\n",
    "    print(f\"Firms only in 2023: {len(firms_2023 - firms_2020)}\")\n",
    "    \n",
    "    # 2. Check data completeness\n",
    "    print(\"\\n2️⃣  DATA COMPLETENESS\")\n",
    "    print(\"-\"*100)\n",
    "    \n",
    "    # Pick a specific date from each period\n",
    "    date_2020 = pd.Timestamp('2020-03-25')\n",
    "    date_2023 = pd.Timestamp('2023-03-01')\n",
    "    \n",
    "    data_2020 = df[df['date'] == date_2020][['gvkey', col_name]].copy()\n",
    "    data_2023 = df[df['date'] == date_2023][['gvkey', col_name]].copy()\n",
    "    \n",
    "    print(f\"\\nDate: {date_2020.strftime('%Y-%m-%d')}\")\n",
    "    print(f\"  Total firms: {len(data_2020)}\")\n",
    "    print(f\"  Firms with spread > 0: {(data_2020[col_name] > 0).sum()}\")\n",
    "    print(f\"  Firms with spread > 1: {(data_2020[col_name] > 1).sum()}\")\n",
    "    print(f\"  Firms with spread > 10: {(data_2020[col_name] > 10).sum()}\")\n",
    "    \n",
    "    print(f\"\\nDate: {date_2023.strftime('%Y-%m-%d')}\")\n",
    "    print(f\"  Total firms: {len(data_2023)}\")\n",
    "    print(f\"  Firms with spread > 0: {(data_2023[col_name] > 0).sum()}\")\n",
    "    print(f\"  Firms with spread > 1: {(data_2023[col_name] > 1).sum()}\")\n",
    "    print(f\"  Firms with spread > 10: {(data_2023[col_name] > 10).sum()}\")\n",
    "    \n",
    "    # 3. Compare same firms across periods\n",
    "    print(\"\\n3️⃣  SAME-FIRM COMPARISON (Firms present in both periods)\")\n",
    "    print(\"-\"*100)\n",
    "    \n",
    "    common_firms = firms_2020 & firms_2023\n",
    "    \n",
    "    if len(common_firms) > 0:\n",
    "        # Get average spread for common firms in each period\n",
    "        spreads_2020_common = crisis_2020[crisis_2020['gvkey'].isin(common_firms)].groupby('gvkey')[col_name].mean()\n",
    "        spreads_2023_common = period_2023[period_2023['gvkey'].isin(common_firms)].groupby('gvkey')[col_name].mean()\n",
    "        \n",
    "        comparison = pd.DataFrame({\n",
    "            'spread_2020': spreads_2020_common,\n",
    "            'spread_2023': spreads_2023_common\n",
    "        }).dropna()\n",
    "        \n",
    "        comparison['change'] = comparison['spread_2023'] - comparison['spread_2020']\n",
    "        comparison['pct_change'] = (comparison['spread_2023'] / comparison['spread_2020'].replace(0, np.nan) - 1) * 100\n",
    "        \n",
    "        print(f\"\\nCommon firms analyzed: {len(comparison)}\")\n",
    "        print(f\"Average spread in 2020 (Mar-May): {comparison['spread_2020'].mean():.2f} bps\")\n",
    "        print(f\"Average spread in 2023 (Jan-Mar): {comparison['spread_2023'].mean():.2f} bps\")\n",
    "        print(f\"Median spread in 2020 (Mar-May): {comparison['spread_2020'].median():.2f} bps\")\n",
    "        print(f\"Median spread in 2023 (Jan-Mar): {comparison['spread_2023'].median():.2f} bps\")\n",
    "        \n",
    "        print(f\"\\nFirms with HIGHER spreads in 2023: {(comparison['change'] > 0).sum()} ({(comparison['change'] > 0).sum()/len(comparison)*100:.1f}%)\")\n",
    "        print(f\"Firms with LOWER spreads in 2023: {(comparison['change'] < 0).sum()} ({(comparison['change'] < 0).sum()/len(comparison)*100:.1f}%)\")\n",
    "        \n",
    "        # Show top movers\n",
    "        print(\"\\n📈 TOP 10 FIRMS: Biggest INCREASE from 2020 to 2023\")\n",
    "        top_increase = comparison.nlargest(10, 'change')\n",
    "        for idx, row in top_increase.iterrows():\n",
    "            try:\n",
    "                company = merton_df[merton_df['gvkey'] == idx]['company'].iloc[0]\n",
    "            except:\n",
    "                company = f\"GVKey {idx}\"\n",
    "            print(f\"  {company:40s}: {row['spread_2020']:7.2f} → {row['spread_2023']:7.2f} bps (+{row['change']:7.2f})\")\n",
    "        \n",
    "        print(\"\\n📉 TOP 10 FIRMS: Biggest DECREASE from 2020 to 2023\")\n",
    "        top_decrease = comparison.nsmallest(10, 'change')\n",
    "        for idx, row in top_decrease.iterrows():\n",
    "            try:\n",
    "                company = merton_df[merton_df['gvkey'] == idx]['company'].iloc[0]\n",
    "            except:\n",
    "                company = f\"GVKey {idx}\"\n",
    "            print(f\"  {company:40s}: {row['spread_2020']:7.2f} → {row['spread_2023']:7.2f} bps ({row['change']:7.2f})\")\n",
    "    \n",
    "    # 4. Check if issue is with NEW firms entering in 2023\n",
    "    print(\"\\n4️⃣  NEW FIRMS IN 2023 (not present in 2020)\")\n",
    "    print(\"-\"*100)\n",
    "    \n",
    "    new_firms_2023 = firms_2023 - firms_2020\n",
    "    if len(new_firms_2023) > 0:\n",
    "        new_firms_data = period_2023[period_2023['gvkey'].isin(new_firms_2023)]\n",
    "        print(f\"\\nNumber of new firms: {len(new_firms_2023)}\")\n",
    "        print(f\"Average spread of new firms: {new_firms_data[col_name].mean():.2f} bps\")\n",
    "        print(f\"Median spread of new firms: {new_firms_data[col_name].median():.2f} bps\")\n",
    "        \n",
    "        print(\"\\nNew firms with highest spreads:\")\n",
    "        for gvkey in new_firms_data.groupby('gvkey')[col_name].mean().nlargest(5).index:\n",
    "            try:\n",
    "                company = merton_df[merton_df['gvkey'] == gvkey]['company'].iloc[0]\n",
    "            except:\n",
    "                company = f\"GVKey {gvkey}\"\n",
    "            avg_spread = new_firms_data[new_firms_data['gvkey'] == gvkey][col_name].mean()\n",
    "            print(f\"  {company:40s}: {avg_spread:7.2f} bps\")\n",
    "    \n",
    "    # 5. Check overall distribution\n",
    "    print(\"\\n5️⃣  OVERALL DISTRIBUTION COMPARISON\")\n",
    "    print(\"-\"*100)\n",
    "    \n",
    "    print(\"\\n2020 (Mar-May) Spread Distribution:\")\n",
    "    print(crisis_2020[col_name].describe())\n",
    "    \n",
    "    print(\"\\n2023 (Jan-Mar) Spread Distribution:\")\n",
    "    print(period_2023[col_name].describe())\n",
    "    \n",
    "    return comparison if len(common_firms) > 0 else None\n",
    "\n",
    "# Run the investigation\n",
    "comparison_df = investigate_time_period_issue('GARCH', maturity=5)"
   ]
  },
