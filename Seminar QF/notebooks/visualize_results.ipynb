    "        on=['date', 'gvkey'],\n",
    "        how='inner'\n",
    "    )\n",
    "    merged = merged.dropna(subset=[model_col, market_col])\n",
    "    merged = merged.sort_values('date')\n",
    "    \n",
    "    if len(merged) == 0:\n",
    "        print(f\"No overlapping data points found\")\n",
    "        return\n",
    "    \n",
    "    # Calculate statistics\n",
    "    corr = merged[model_col].corr(merged[market_col])\n",
    "    rmse = np.sqrt(((merged[model_col] - merged[market_col])**2).mean())\n",
    "    \n",
    "    # Create figure with 2 panels\n",
    "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 10))\n",
    "    \n",
    "    # Top panel: Time series\n",
    "    ax1.plot(merged['date'], merged[market_col], \n",
    "             linewidth=2.5, label='Market CDS', color='black', alpha=0.8)\n",
    "    ax1.plot(merged['date'], merged[model_col], \n",
    "             linewidth=2, label=f'{model_name} Implied', color='#d62728', linestyle='--', alpha=0.8)\n",
    "    \n",
    "    ax1.set_title(f'CDS Spreads: {company_name} ({maturity}-Year Maturity)\\n' +\n",
    "                  f'{model_name} vs Market | Correlation: {corr:.3f} | RMSE: {rmse:.1f} bps',\n",
    "                  fontsize=14, fontweight='bold')\n",
    "    ax1.set_xlabel('Date', fontsize=12)\n",
    "    ax1.set_ylabel('CDS Spread (basis points)', fontsize=12)\n",
    "    ax1.legend(loc='best', fontsize=11)\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Bottom panel: Scatter plot\n",
    "    ax2.scatter(merged[market_col], merged[model_col], alpha=0.6, s=30, color='#1f77b4')\n",
    "    \n",
    "    # Add 45-degree line (perfect prediction)\n",
    "    min_val = min(merged[market_col].min(), merged[model_col].min())\n",
    "    max_val = max(merged[market_col].max(), merged[model_col].max())\n",
    "    ax2.plot([min_val, max_val], [min_val, max_val], 'r--', linewidth=2, label='Perfect Fit (45°)')\n",
    "    \n",
    "    # Add regression line\n",
    "    z = np.polyfit(merged[market_col], merged[model_col], 1)\n",
    "    p = np.poly1d(z)\n",
    "    x_line = np.linspace(min_val, max_val, 100)\n",
    "    ax2.plot(x_line, p(x_line), 'g-', linewidth=2, alpha=0.7, \n",
    "             label=f'Regression (slope={z[0]:.2f}, intercept={z[1]:.1f})')\n",
    "    \n",
    "    ax2.set_xlabel(f'Market CDS Spread (bps)', fontsize=12)\n",
    "    ax2.set_ylabel(f'{model_name} Implied Spread (bps)', fontsize=12)\n",
    "    ax2.set_title(f'Model vs Market: Scatter Plot', fontsize=13, fontweight='bold')\n",
    "    ax2.legend(loc='best', fontsize=11)\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # Print detailed statistics\n",
    "    print(f\"\\nStatistics for {company_name} ({maturity}Y):\")\n",
    "    print(f\"{'Metric':<30} {'Market':<15} {model_name:<15}\")\n",
    "    print(\"-\" * 60)\n",
    "    print(f\"{'Observations':<30} {len(merged):>13}\")\n",
    "    print(f\"{'Mean Spread (bps)':<30} {merged[market_col].mean():>13.2f}  {merged[model_col].mean():>13.2f}\")\n",
    "    print(f\"{'Std Spread (bps)':<30} {merged[market_col].std():>13.2f}  {merged[model_col].std():>13.2f}\")\n",
    "    print(f\"{'Min Spread (bps)':<30} {merged[market_col].min():>13.2f}  {merged[model_col].min():>13.2f}\")\n",
    "    print(f\"{'Max Spread (bps)':<30} {merged[market_col].max():>13.2f}  {merged[model_col].max():>13.2f}\")\n",
    "    print(f\"\\n{'Correlation':<30} {corr:>13.4f}\")\n",
    "    print(f\"{'RMSE (bps)':<30} {rmse:>13.2f}\")\n",
    "    print(f\"{'Mean Difference (bps)':<30} {(merged[model_col] - merged[market_col]).mean():>13.2f}\")\n",
    "    print(f\"{'Mean Absolute Error (bps)':<30} {np.abs(merged[model_col] - merged[market_col]).mean():>13.2f}\")\n",
    "\n",
    "print(\"✓ Function 'plot_company_market_vs_model' defined\")"
