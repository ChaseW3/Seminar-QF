    "def plot_median_market_vs_model(model_name, maturity=5):\n",
    "    \"\"\"\n",
    "    Plot time series comparing MEDIAN market CDS spreads vs MEDIAN model-implied spreads\n",
    "    across all firms in the dataset.\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    model_name : str\n",
    "        The model to compare ('GARCH', 'Regime Switching', 'MS-GARCH', 'Merton')\n",
    "    maturity : int\n",
    "        Maturity in years (1, 3, or 5)\n",
    "    \"\"\"\n",
    "    if model_name not in plotter.data:\n",
    "        print(f\"Error: Model '{model_name}' not loaded.\")\n",
    "        return\n",
    "    \n",
    "    # Get model data\n",
    "    model_df = plotter.data[model_name].copy()\n",
    "    model_col = f'spread_{maturity}y_bps'\n",
    "    \n",
    "    if model_col not in model_df.columns:\n",
    "        print(f\"Error: {model_col} not found in model data\")\n",
    "        return\n",
    "    \n",
    "    # Calculate daily median spreads across all firms for model\n",
    "    model_df['date'] = pd.to_datetime(model_df['date'])\n",
    "    model_median = model_df.groupby('date')[model_col].median().reset_index()\n",
    "    model_median.columns = ['date', 'model_median_spread']\n",
    "    \n",
    "    # Calculate daily median spreads across all firms for market\n",
    "    market_col = f'cds_market_{maturity}y_bps'\n",
    "    if market_col not in market_cds.columns:\n",
    "        print(f\"Error: {market_col} not found in market data\")\n",
    "        return\n",
    "    \n",
    "    market_median = market_cds.groupby('date')[market_col].median().reset_index()\n",
    "    market_median.columns = ['date', 'market_median_spread']\n",
    "    \n",
    "    # Merge market and model medians\n",
    "    merged = model_median.merge(market_median, on='date', how='inner')\n",
    "    merged = merged.dropna()\n",
    "    \n",
    "    if len(merged) == 0:\n",
    "        print(f\"No overlapping dates found\")\n",
    "        return\n",
    "    \n",
    "    # Calculate correlation and RMSE\n",
    "    corr = merged['model_median_spread'].corr(merged['market_median_spread'])\n",
    "    rmse = np.sqrt(((merged['model_median_spread'] - merged['market_median_spread'])**2).mean())\n",
    "    \n",
    "    # Create plot\n",
    "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 10))\n",
    "    \n",
    "    # Top panel: Time series\n",
    "    ax1.plot(merged['date'], merged['market_median_spread'], \n",
    "             linewidth=2.5, label='Market CDS (Median)', color='black', alpha=0.8)\n",
    "    ax1.plot(merged['date'], merged['model_median_spread'], \n",
    "             linewidth=2, label=f'{model_name} (Median)', color='#d62728', linestyle='--', alpha=0.8)\n",
    "    \n",
    "    ax1.set_title(f'Median CDS Spreads: Market vs {model_name} ({maturity}-Year Maturity)\\n' +\n",
    "                  f'Correlation: {corr:.3f} | RMSE: {rmse:.1f} bps | N={len(merged)} days',\n",
    "                  fontsize=14, fontweight='bold')\n",
    "    ax1.set_xlabel('Date', fontsize=12)\n",
    "    ax1.set_ylabel('Median CDS Spread (basis points)', fontsize=12)\n",
    "    ax1.legend(loc='best', fontsize=11)\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Bottom panel: Scatter plot\n",
    "    ax2.scatter(merged['market_median_spread'], merged['model_median_spread'], \n",
